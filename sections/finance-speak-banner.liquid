{% comment %}
  Section: finance-speak-banner.liquid
  Location: /sections/finance-speak-banner.liquid
  Theme: Dawn 15 — Penta Motor Group
{% endcomment %}

<style>
  #finance-speak-{{ section.id }} {
    background-color: {{ section.settings.outer_bg }};
  }

  #finance-speak-{{ section.id }} .fsb-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px 72px;
  }

  #finance-speak-{{ section.id }} .fsb-banner {
    background-color: {{ section.settings.banner_bg }};
    padding: 56px 40px;
    text-align: center;
    position: relative;
  }

  /* Gold top border accent */
  #finance-speak-{{ section.id }} .fsb-banner::before {
    content: '';
    display: block;
    position: absolute;
    top: 0;
    left: 40px;
    right: 40px;
    height: 2px;
    background: {{ section.settings.accent_color }};
  }

  #finance-speak-{{ section.id }} .fsb-heading {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: clamp(1.8rem, 2.5vw, 1.9rem);
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
    margin: 0 0 16px;
  }

  #finance-speak-{{ section.id }} .fsb-text {
    font-family: var(--font-body-family);
    font-size: 0.97rem;
    line-height: 1.7;
    color: {{ section.settings.body_color }};
    max-width: 560px;
    margin: 0 auto 32px;
  }

  #finance-speak-{{ section.id }} .fsb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body-family);
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 36px;
    background-color: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text }} !important;
    border: 2px solid {{ section.settings.btn_bg }};
    border-radius: var(--buttons-radius, 0px);
    transition: opacity 0.2s ease;
  }
  #finance-speak-{{ section.id }} .fsb-btn:hover { opacity: 0.82; }
</style>

<div id="finance-speak-{{ section.id }}">
  <div class="fsb-inner">
    <div class="fsb-banner">
      <h2 class="fsb-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="fsb-text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <a href="{{ section.settings.cta_url }}" class="fsb-btn">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Finance – Speak to Us",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Prefer to Speak to Us First?" },
    { "type": "textarea", "id": "text", "label": "Body text", "default": "Our finance specialists will discuss your options, explain the process clearly, and help you understand what to expect so you can move forward with confidence." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Send a Finance Enquiry" },
    { "type": "url", "id": "cta_url", "label": "Button URL" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "outer_bg", "label": "Outer section background", "default": "#FFFFFF" },
    { "type": "color", "id": "banner_bg", "label": "Banner background", "default": "#111111" },
    { "type": "color", "id": "accent_color", "label": "Top border accent", "default": "#C8A96E" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#FFFFFF" },
    { "type": "color", "id": "body_color", "label": "Body text", "default": "#AAAAAA" },
    { "type": "header", "content": "Button colours" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#C8A96E" },
    { "type": "color", "id": "btn_text", "label": "Button text", "default": "#111111" }
  ],
  "presets": [{ "name": "Finance – Speak to Us" }]
}
{% endschema %}
