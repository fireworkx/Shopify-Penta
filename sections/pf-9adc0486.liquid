_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-laNFUy ymAQo pf-165_">2013</span></h3></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-hGMjVM cQDYcy pf-166_"><div data-pf-type="Divider" class="sc-bkENKe dkwUhI pf-167_ pf-divider-1"></div></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-hGMjVM cQDYcy pf-170_"><h3 data-pf-type="Heading" class="sc-hYmYN cpglDO pf-171_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-laNFUy ymAQo pf-173_">Suzuki Klerksdorp<span style="font-weight: normal;"> </span>opens<span style="font-weight: normal;"> their doors in May, shortly followed by </span>Renault Klerksdorp<span style="font-weight: normal;"> who delivers their first Clio.</span></span></h3></div></div></div><div class="sc-hZDzol kRuHOG pf-174_ pf-r pf-r-eh" style="--s-xs:0px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-hGMjVM cQDYcy pf-175_"><div data-pf-type="Divider" class="sc-bkENKe dkwUhI pf-176_ pf-divider-1"></div></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-hGMjVM cQDYcy pf-179_"><h3 data-pf-type="Heading" class="sc-hYmYN cpglDO pf-180_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-laNFUy ymAQo pf-182_">2014</span></h3></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-hGMjVM cQDYcy pf-183_"><div data-pf-type="Divider" class="sc-bkENKe dkwUhI pf-184_ pf-divider-1"></div></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-hGMjVM cQDYcy pf-187_"><h3 data-pf-type="Heading" class="sc-hYmYN cpglDO pf-188_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-laNFUy ymAQo pf-190_"><span style="font-weight: normal;">Establishing our </span>G