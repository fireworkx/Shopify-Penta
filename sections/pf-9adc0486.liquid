281_ pf-divider-1"></div></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-eoVZcn cepmFm pf-284_"><h3 data-pf-type="Heading" class="sc-cVzzKN eMDdXJ pf-285_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-bOQUxc quwHz pf-287_"><span style="font-weight: normal;">Covid-19 changes the course of history. During the lockdown, our in-house marketing team creates fresh, innovative ways that address mobility. We're excited for the future, lining up new projects to be launched. </span>Penta welcomes our North West branch: Hyundai Brits<span style="font-weight: normal;">.</span></span></h3></div></div></div><div class="sc-hzhKNl fltMam pf-288_ pf-r pf-r-eh" style="--s-xs:0px" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-eoVZcn cepmFm pf-289_"><div data-pf-type="Divider" class="sc-bDunJF gzxnfF pf-290_ pf-divider-1"></div></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-eoVZcn cepmFm pf-293_"><h3 data-pf-type="Heading" class="sc-cVzzKN eMDdXJ pf-294_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-bOQUxc quwHz pf-296_">2021</span></h3></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-eoVZcn cepmFm pf-297_"><div data-pf-type="Divider" class="sc-bDunJF gzxnfF pf-298_ pf-divider-1"></div></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-eoVZcn cepmFm pf-301_"><h3 data-pf-type="Heading" class="sc-cVzzKN eMDdXJ pf-302_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-bOQUxc quwHz pf-304_">Penta ventures into the fleet and rental market<span style="font-weight: 400;">,</span> launching Drive<span style="font-weight: 400;"> and </span>Penta Fleet Solutions<span style="font-weight: 400;">. This year also holds some excitement with the </span>opening of our Chery floor <span style="font-weight: normal;">at</span> Penta Menlyn<span style="font-weight: 400;">. In addition, PMG officially </span><span style="font-weight: normal;">won</span> Suzuki's volume dealer of the year award 2020<span style="font-weight: 400;"> with </span>Suzuki Rustenburg<span style="font-weight: 400;"> being the overall dealer of the year.</span></span></h3></div></div></div><div class="sc-hzhKNl fltMam pf-305_ pf-r pf-r-eh" style="--s-xs:0px" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-eoVZcn cepmFm pf-306_"><div data-pf-type="Divider" class="sc-bDunJF gzxnfF pf-307_ pf-divider-1"></div></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-eoVZcn cepmFm pf-310_"><h3 data-pf-type="Heading" class="sc-cVzzKN eMDdXJ pf-311_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-bOQUxc quwHz pf-313_">2022</span></h3></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-eoVZcn cepmFm pf-314_"><div data-pf-type="Divider" class="sc-bDunJF gzxnfF pf-315_ pf-divider-1"></div></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-eoVZcn cepmFm pf-318_"><h3 data-pf-type="Heading" class="sc-cVzzKN eMDdXJ pf-319_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-bOQUxc quwHz pf-321_"><span style="font-weight: 400;">Penta opens the <strong>PMG fitment centre</strong>, providing vehicle customisations to meet the unique needs of our clients. Additionally, we opened the doors to the <strong>Suzuki Experience Store</strong> in <strong>Menlyn Park Shopping Centre</strong>, allowing us to make it easier for our customers to access our products.<br></span></span></h3></div></div></div><div class="sc-hzhKNl fltMam pf-322_ pf-r pf-r-eh" style="--s-xs:0px" data-pf-type="Row"><div class="pf-c" st