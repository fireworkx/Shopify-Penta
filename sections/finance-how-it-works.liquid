{% comment %}
  Section: finance-how-it-works.liquid
  Location: /sections/finance-how-it-works.liquid
  Theme: Dawn 15 — Penta Motor Group
{% endcomment %}

<style>
  #finance-how-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }

  #finance-how-{{ section.id }} .fhow-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: 72px 24px;
  }

  #finance-how-{{ section.id }} .fhow-label {
    display: inline-block;
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin-bottom: 16px;
  }

  #finance-how-{{ section.id }} .fhow-heading {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: {{ section.settings.heading_color }};
    margin: 0 0 40px;
  }

  #finance-how-{{ section.id }} .fhow-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 48px;
  }

  #finance-how-{{ section.id }} .fhow-card {
    background: {{ section.settings.card_bg }};
    border: 1px solid {{ section.settings.card_border }};
    padding: 32px 24px;
  }

  #finance-how-{{ section.id }} .fhow-card__number {
    font-family: var(--font-heading-family);
    font-size: 2.6rem;
    font-weight: 800;
    color: {{ section.settings.accent_color }};
    line-height: 1;
    margin-bottom: 16px;
    opacity: 0.9;
  }

  #finance-how-{{ section.id }} .fhow-card__text {
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    line-height: 1.6;
    color: {{ section.settings.body_color }};
  }

  #finance-how-{{ section.id }} .fhow-tagline {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-style: italic;
    color: {{ section.settings.tagline_color }};
    border-left: 3px solid {{ section.settings.accent_color }};
    padding-left: 20px;
    margin: 0;
    line-height: 1.6;
  }
</style>

<div id="finance-how-{{ section.id }}">
  <div class="fhow-inner">
    {%- if section.settings.label != blank -%}
      <p class="fhow-label">{{ section.settings.label }}</p>
    {%- endif -%}
    <h2 class="fhow-heading">{{ section.settings.heading }}</h2>

    <div class="fhow-grid">
      {%- for block in section.blocks -%}
        <div class="fhow-card" {{ block.shopify_attributes }}>
          <div class="fhow-card__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          <p class="fhow-card__text">{{ block.settings.step_text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.tagline != blank -%}
      <p class="fhow-tagline">{{ section.settings.tagline }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Finance – How It Works",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "label", "label": "Section label", "default": "Process" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How It Works" },
    { "type": "text", "id": "tagline", "label": "Tagline (below steps)", "default": "Simple. Transparent. Managed for you." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent / label / numbers", "default": "#C8A96E" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#111111" },
    { "type": "color", "id": "body_color", "label": "Step text", "default": "#444444" },
    { "type": "color", "id": "tagline_color", "label": "Tagline text", "default": "#666666" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FAFAFA" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#E8E6E2" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "textarea", "id": "step_text", "label": "Step description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Finance – How It Works",
      "blocks": [
        { "type": "step", "settings": { "step_text": "Submit your online application or enquiry" } },
        { "type": "step", "settings": { "step_text": "We structure the best available deal based on your profile" } },
        { "type": "step", "settings": { "step_text": "We liaise with the banks on your behalf" } },
        { "type": "step", "settings": { "step_text": "You receive feedback and next steps quickly" } }
      ]
    }
  ]
}
{% endschema %}
